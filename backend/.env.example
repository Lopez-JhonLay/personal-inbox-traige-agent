# Flask uses --debug for local debugging; FLASK_ENV was removed in Flask 2.3.
# Generate a local secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Neon pooled URL for the app; direct (non-pooler) URL for Alembic.
# Copy the Neon URLs including sslmode=require. Both postgresql:// and
# postgresql+psycopg:// are supported. Leave blank to run health checks only.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Google OAuth Web application client. Enable Gmail API, use External/Testing,
# and add your Gmail address as a test user. See the Phase 4 guide in docs/TASKS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Phase 5 verification: only import inbox messages with this Gmail label.
# Clear the value to import up to 20 recent inbox messages after reviewing AI data policies.
GMAIL_SYNC_QUERY=label:mailkind-test

OPENROUTER_API_KEY=
# Evaluated fixed free model. No automatic model fallback is configured.
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local synthetic-email endpoint only. Leave disabled outside local development.
ENABLE_DEV_ANALYSIS=false

# Fernet key for encrypted refresh tokens. Generate once and retain it:
# uv run --project backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Replacing this key makes existing tokens unreadable; reconnect accounts afterward.
TOKEN_ENCRYPTION_KEY=
