# Flask uses --debug for local debugging; FLASK_ENV was removed in Flask 2.3.
# Generate a local secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Neon pooled URL for the app; direct (non-pooler) URL for Alembic.
# Copy the Neon URLs including sslmode=require. Both postgresql:// and
# postgresql+psycopg:// are supported. Leave blank to run health checks only.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Google OAuth web application credentials; no OAuth routes exist yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

OPENROUTER_API_KEY=
# Evaluated fixed free model. No automatic model fallback is configured.
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local synthetic-email endpoint only. Leave disabled outside local development.
ENABLE_DEV_ANALYSIS=false

# Reserved for future encryption of persisted OAuth tokens.
TOKEN_ENCRYPTION_KEY=
