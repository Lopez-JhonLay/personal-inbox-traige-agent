{
  "files.eol": "\n",
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "prettier.prettierPath": "./frontend/node_modules/prettier",
  "prettier.configPath": "./frontend/.prettierrc.json",
  "biome.enabled": true,
  "biome.requireConfiguration": true,
  "biome.configurationPath": "./frontend/biome.json",
  "biome.lsp.bin": {
    "win32-x64": "./frontend/node_modules/@biomejs/cli-win32-x64/biome.exe"
  },
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./frontend/node_modules/typescript",
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.envFile": "${workspaceFolder}/backend/.env",
  "python.analysis.extraPaths": ["./backend"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],
  "ruff.path": ["${workspaceFolder}/backend/.venv/Scripts/ruff.exe"],
  "ruff.configurationPreference": "filesystemFirst"
}
